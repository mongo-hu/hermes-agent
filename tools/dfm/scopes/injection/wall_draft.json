{
  "scope_id": "injection.wall-draft",
  "version": "3.0.0",
  "process": "injection",
  "fact_requirements": [
    {
      "name": "process",
      "phase": "discovery",
      "question": "Should this project be analyzed as injection molding or die casting?",
      "required_by": ["feature.process_semantics"]
    },
    {
      "name": "model_units",
      "phase": "discovery",
      "question": "What length unit was used to author the STEP model?",
      "required_by": ["feature.dimension_classification", "geometry.load"]
    },
    {
      "name": "material",
      "phase": "analysis",
      "question": "What resin/material grade will be used for this part?",
      "required_by": ["rule.wall_thickness"]
    },
    {
      "name": "pull_dir",
      "phase": "analysis",
      "question": "What is the confirmed mold pull direction as [x, y, z]?",
      "required_by": ["geometry.draft"]
    }
  ],
  "material_profiles": {
    "ABS": {
      "min_wall_mm": 1.2,
      "source": "validated_demo_baseline"
    }
  },
  "parameters": {
    "material": {
      "value": "ABS",
      "unit": null,
      "kind": "engineering_context"
    },
    "model_units": {
      "value": "mm",
      "unit": null,
      "kind": "engineering_context"
    },
    "pull_dir": {
      "value": [0, 0, 1],
      "unit": null,
      "kind": "engineering_context"
    },
    "min_wall_mm": {
      "value": 1.2,
      "unit": "mm",
      "kind": "rule"
    },
    "min_draft_deg": {
      "value": 1.0,
      "unit": "degree",
      "kind": "rule"
    }
  },
  "rule_profiles": {
    "ordinary.wall_draft": {
      "feature_kind": "ordinary_part",
      "region_role": "ordinary",
      "status": "available",
      "bindings": [
        {"metric_id": "injection.geometry.wall_thickness", "quantity_id": "thickness_mm", "rule_id": "min_wall_mm", "operator": ">=", "aggregation": "minimum"},
        {"metric_id": "injection.geometry.draft", "quantity_id": "draft_angle_deg", "rule_id": "min_draft_deg", "operator": ">=", "aggregation": "minimum"}
      ]
    },
    "screw_boss.wall_draft": {"feature_kind": "screw_boss", "region_role": "wall", "status": "fallback", "fallback_to": "ordinary.wall_draft", "bindings": []},
    "rib.wall_draft": {"feature_kind": "rib", "region_role": "wall", "status": "fallback", "fallback_to": "ordinary.wall_draft", "bindings": []}
  },
  "operations": [
    {
      "operation_id": "geometry.load",
      "calculator_id": "load_geometry",
      "depends_on": [],
      "metric_ids": [],
      "required_quantities": [],
      "required_artifacts": [],
      "required_fact_names": ["model_units"],
      "arguments": {},
      "algorithm_options": {}
    },
    {
      "operation_id": "geometry.topology",
      "calculator_id": "inspect_topology",
      "depends_on": ["geometry.load"],
      "metric_ids": [],
      "required_quantities": [],
      "required_artifacts": [],
      "required_fact_names": [],
      "arguments": {},
      "algorithm_options": {}
    },
    {
      "operation_id": "geometry.wall_thickness",
      "calculator_id": "measure_wall_thickness",
      "depends_on": ["geometry.topology"],
      "metric_ids": ["injection.geometry.wall_thickness"],
      "required_quantities": ["thickness_mm"],
      "required_artifacts": ["scalar_field", "render_scene", "topology_map"],
      "required_fact_names": ["model_units"],
      "arguments": {},
      "algorithm_options": {}
    },
    {
      "operation_id": "geometry.draft",
      "calculator_id": "measure_draft",
      "depends_on": ["geometry.topology"],
      "metric_ids": ["injection.geometry.draft"],
      "required_quantities": ["draft_angle_deg"],
      "required_artifacts": ["scalar_field", "render_scene", "topology_map"],
      "required_fact_names": ["pull_dir", "model_units"],
      "arguments": {},
      "algorithm_options": {}
    }
  ],
  "rule_bindings": [
    {
      "binding_id": "binding.wall_thickness.minimum",
      "operation_id": "geometry.wall_thickness",
      "metric_id": "injection.geometry.wall_thickness",
      "quantity_id": "thickness_mm",
      "rule_id": "min_wall_mm",
      "operator": ">=",
      "aggregation": "minimum",
      "required_fact_names": ["material"]
    },
    {
      "binding_id": "binding.draft.minimum",
      "operation_id": "geometry.draft",
      "metric_id": "injection.geometry.draft",
      "quantity_id": "draft_angle_deg",
      "rule_id": "min_draft_deg",
      "operator": ">=",
      "aggregation": "minimum",
      "required_fact_names": []
    }
  ]
}
