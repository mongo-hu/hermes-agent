{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/evidence-record.schema.json",
  "title": "Hermes DFM Evidence Records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "input_sha256", "producer", "producer_version", "coverage", "records"],
  "properties": {
    "schema_version": {"const": 3},
    "run_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {"const": "hermes-evidence-renderer"},
    "producer_version": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_patch_count", "covered_patch_count", "coverage_ratio", "covered_patch_ids", "uncovered_patch_ids", "required_sample_count", "covered_sample_count", "uncovered_sample_refs"],
      "properties": {
        "required_patch_count": {"type": "integer", "minimum": 0},
        "covered_patch_count": {"type": "integer", "minimum": 0},
        "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "covered_patch_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "uncovered_patch_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_sample_count": {"type": "integer", "minimum": 0},
        "covered_sample_count": {"type": "integer", "minimum": 0},
        "uncovered_sample_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "run_id", "input_sha256", "measurement_ids", "evaluation_ids", "geometry_refs", "feature_refs", "artifact_ref", "render"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "run_id": {"type": "string", "minLength": 1},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "operation_id": {"type": "string", "minLength": 1},
          "metric_id": {"type": "string", "minLength": 1},
          "geometric_id": {"type": "string", "pattern": "^G_[A-Z0-9_]+$"},
          "measurement_ids": {"type": "array", "items": {"type": "string"}},
          "evaluation_ids": {"type": "array", "items": {"type": "string"}},
          "geometry_refs": {"type": "array", "items": {"$ref": "#/$defs/geometryRef"}},
          "region_refs": {"type": "array", "items": {"type": "string"}},
          "feature_refs": {"type": "array", "items": {"type": "string"}},
          "artifact_ref": {"type": "string", "minLength": 1},
          "render": {"type": "object"}
        },
        "oneOf": [
          {
            "required": ["geometric_id"],
            "not": {"anyOf": [
              {"required": ["operation_id"]},
              {"required": ["metric_id"]},
              {"required": ["region_refs"]}
            ]}
          },
          {
            "required": ["operation_id", "metric_id", "region_refs"],
            "not": {"required": ["geometric_id"]}
          }
        ]
      }
    }
  },
  "$defs": {
    "geometryRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "index", "input_sha256", "topology_snapshot_id", "entity_id"],
      "properties": {"kind": {"enum": ["face", "edge", "solid", "vertex"]}, "index": {"type": "integer", "minimum": 1}, "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "topology_snapshot_id": {"type": "string", "minLength": 1}, "entity_id": {"type": "string", "minLength": 1}}
    }
  }
}
