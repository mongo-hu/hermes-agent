{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/evidence-record.schema.json",
  "title": "Hermes DFM Evidence Records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "input_sha256", "producer", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {"const": "hermes-evidence-renderer"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "run_id", "input_sha256", "operation_id", "metric_id", "measurement_ids", "evaluation_ids", "geometry_refs", "region_refs", "artifact_ref", "render", "feature_refs"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "run_id": {"type": "string", "minLength": 1},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "operation_id": {"type": "string", "minLength": 1},
          "metric_id": {"type": "string", "minLength": 1},
          "measurement_ids": {"type": "array", "items": {"type": "string"}},
          "evaluation_ids": {"type": "array", "items": {"type": "string"}},
          "geometry_refs": {"type": "array", "items": {"$ref": "#/$defs/geometryRef"}},
          "region_refs": {"type": "array", "items": {"type": "string"}},
          "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "artifact_ref": {"type": "string", "minLength": 1},
          "render": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "geometryRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "index", "input_sha256"],
      "properties": {"kind": {"enum": ["face", "edge", "solid", "vertex"]}, "index": {"type": "integer", "minimum": 0}, "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "topology_snapshot_id": {"type": "string"}, "entity_id": {"type": "string"}}
    }
  }
}
