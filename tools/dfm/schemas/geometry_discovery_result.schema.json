{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/geometry-discovery-result.schema.json",
  "title": "Hermes DFM Geometry Discovery Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_version",
    "request_id",
    "input_id",
    "input_sha256",
    "process",
    "topology_snapshot_id",
    "render_mesh_snapshot_id",
    "geometry_snapshot_ref",
    "observations",
    "features",
    "regions",
    "recognizers",
    "artifacts",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "input_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "process": {"type": "string", "minLength": 1},
    "topology_snapshot_id": {"type": "string", "minLength": 1},
    "render_mesh_snapshot_id": {"type": "string", "minLength": 1},
    "geometry_snapshot_ref": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    },
    "features": {
      "type": "array",
      "items": {"$ref": "#/$defs/feature"}
    },
    "regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/region"}
    },
    "recognizers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/recognizer"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/artifact"},
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "geometry_snapshot"}}, "required": ["kind"]}, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "topology_map"}}, "required": ["kind"]}, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "render_scene"}}, "required": ["kind"]}, "maxContains": 1}
      ]
    },
    "diagnostics": {"type": "object"}
  },
  "$defs": {
    "geometryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index", "input_sha256", "topology_snapshot_id", "entity_id"],
      "properties": {
        "kind": {"const": "face"},
        "index": {"type": "integer", "minimum": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "topology_snapshot_id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1}
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
        "maximum": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "input_sha256", "coordinate_system", "mode", "semantic_label", "role", "feature_refs", "source_refs", "version", "content_sha256", "bbox", "geometry_refs", "excluded_geometry_refs"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coordinate_system": {"type": "string", "minLength": 1},
        "mode": {"enum": ["bbox", "topology_refs", "topology_complement", "whole_model"]},
        "semantic_label": {"type": "string"},
        "role": {"type": "string"},
        "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "version": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bbox": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bbox"}]},
        "geometry_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/geometryRef"}},
        "excluded_geometry_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/geometryRef"}}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "kind", "source_refs", "confidence", "input_sha256", "region_refs", "properties", "relationships", "recognizer", "recognizer_version", "status"],
      "properties": {
        "feature_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "region_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "properties": {"type": "object"},
        "relationships": {"type": "array", "items": {"type": "object"}},
        "recognizer": {"type": "string", "minLength": 1},
        "recognizer_version": {"type": "string", "minLength": 1},
        "status": {"enum": ["detected", "confirmed", "rejected", "needs_confirmation"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "input_id", "kind", "value", "source_refs", "confidence", "status", "unit", "region_refs", "feature_refs", "provenance"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "input_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "value": {},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"type": "string", "minLength": 1},
        "unit": {"type": ["string", "null"]},
        "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "provenance": {"type": "object"}
      }
    },
    "recognizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recognizer_id", "status", "implementation_version", "feature_refs", "region_refs", "observation_refs", "missing_fact_names", "diagnostics"],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
          "then": {"properties": {"missing_fact_names": {"minItems": 1}}},
          "else": {"properties": {"missing_fact_names": {"maxItems": 0}}}
        }
      ],
      "properties": {
        "recognizer_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["completed", "blocked", "not_implemented", "failed"]},
        "implementation_version": {"type": "string"},
        "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_fact_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "diagnostics": {"type": "object"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "filename", "media_type", "size_bytes", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
