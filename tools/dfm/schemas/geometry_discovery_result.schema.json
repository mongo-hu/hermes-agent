{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/geometry-discovery-result.schema.json",
  "title": "Hermes DFM Geometry Discovery Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_version", "request_id", "input_id", "input_sha256", "process", "topology_snapshot_id", "render_mesh_snapshot_id", "geometry_snapshot_ref", "observations", "features", "regions", "recognizers", "artifacts", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "input_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "process": {"type": "string", "minLength": 1},
    "topology_snapshot_id": {"type": "string", "minLength": 1},
    "render_mesh_snapshot_id": {"type": "string", "minLength": 1},
    "geometry_snapshot_ref": {"type": "string", "minLength": 1},
    "observations": {"type": "array", "items": {"type": "object"}},
    "features": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "regions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "recognizers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recognizer"}},
    "artifacts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/artifact"}},
    "diagnostics": {"type": "object"}
  },
  "$defs": {
    "recognizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recognizer_id", "status", "implementation_version", "feature_refs", "region_refs", "observation_refs", "missing_fact_names", "diagnostics"],
      "properties": {
        "recognizer_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["completed", "blocked", "not_implemented", "failed"]},
        "implementation_version": {"type": "string"},
        "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_fact_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "diagnostics": {"type": "object"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "filename", "media_type", "size_bytes", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
