{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/ontology-snapshot.schema.json",
  "title": "Published DFM Ontology Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "ontology_version",
    "published_at",
    "content_sha256",
    "rule_set",
    "concepts",
    "relations",
    "factor_options",
    "rules"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "snapshot_id": {"type": "string", "minLength": 1},
    "ontology_version": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule_set": {"$ref": "#/$defs/ruleSet"},
    "concepts": {
      "type": "array",
      "items": {"$ref": "#/$defs/concept"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "factor_options": {
      "type": "array",
      "items": {"$ref": "#/$defs/factorOption"}
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/ruleVersion"}
    }
  },
  "$defs": {
    "ruleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_set_code", "version", "process", "scope_type", "scope_key"],
      "properties": {
        "rule_set_code": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "process": {"type": "string", "minLength": 1},
        "scope_type": {"enum": ["system", "organization", "customer"]},
        "scope_key": {"type": "string", "minLength": 1}
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "concept_type", "name_zh", "definition", "status"],
      "properties": {
        "concept_id": {"type": "string", "minLength": 1},
        "concept_type": {
          "enum": ["process", "feature_type", "region_type", "metric", "check", "factor"]
        },
        "name_zh": {"type": "string", "minLength": 1},
        "name_en": {"type": "string"},
        "definition": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "data_schema": {"type": ["object", "null"]},
        "properties": {"type": "object"},
        "status": {"enum": ["draft", "active", "retired"]}
      },
      "allOf": [
        {
          "if": {
            "required": ["concept_type"],
            "properties": {"concept_type": {"const": "factor"}}
          },
          "then": {
            "required": ["properties"],
            "properties": {
              "properties": {
                "required": ["source_policy"],
                "properties": {
                  "source_policy": {"$ref": "#/$defs/sourcePolicy"}
                }
              }
            }
          }
        }
      ]
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_sources",
        "auto_accept_sources",
        "confirmation_required_sources",
        "min_confidence",
        "evidence_required",
        "conflict_policy",
        "missing_policy"
      ],
      "properties": {
        "allowed_sources": {"$ref": "#/$defs/factorSources"},
        "auto_accept_sources": {"$ref": "#/$defs/factorSources"},
        "confirmation_required_sources": {"$ref": "#/$defs/factorSources"},
        "min_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_required": {"type": "boolean"},
        "conflict_policy": {"const": "ask_user"},
        "missing_policy": {"const": "ask_user"}
      }
    },
    "factorSources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "user",
          "project_metadata",
          "drawing_recognition",
          "geometry_recognition",
          "derived_program"
        ]
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "subject_id", "predicate", "object_id", "qualifiers"],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "predicate": {
          "enum": [
            "HAS_CHECK",
            "HAS_REGION",
            "APPLIES_TO_FEATURE",
            "APPLIES_TO_REGION",
            "USES_OPERAND",
            "REQUIRES_FACTOR",
            "AFFECTS",
            "RELATED_TO"
          ]
        },
        "object_id": {"type": "string", "minLength": 1},
        "qualifiers": {"type": "object"},
        "sort_order": {"type": "integer"}
      },
      "allOf": [
        {
          "if": {"properties": {"predicate": {"const": "USES_OPERAND"}}},
          "then": {
            "properties": {
              "qualifiers": {
                "type": "object",
                "additionalProperties": false,
                "required": ["alias", "aggregation", "required"],
                "properties": {
                  "alias": {"type": "string", "minLength": 1},
                  "aggregation": {"type": "string", "minLength": 1},
                  "required": {"type": "boolean"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"predicate": {"const": "APPLIES_TO_REGION"}}},
          "then": {
            "properties": {
              "qualifiers": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "operand_aliases": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "factorOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "option_code", "name_zh", "value", "status"],
      "properties": {
        "factor_id": {"type": "string", "minLength": 1},
        "option_code": {"type": "string", "minLength": 1},
        "name_zh": {"type": "string", "minLength": 1},
        "value": {},
        "sort_order": {"type": "integer"},
        "status": {"enum": ["active", "retired"]}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "operator"],
      "properties": {
        "factor_id": {"type": "string", "minLength": 1},
        "operator": {"enum": ["EQ", "IN", "GT", "GTE", "LT", "LTE", "BETWEEN", "EXISTS"]},
        "value": {}
      }
    },
    "ruleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_version_id",
        "rule_id",
        "version",
        "check_id",
        "name",
        "conditions",
        "expression",
        "comparator",
        "threshold",
        "severity",
        "priority",
        "is_default",
        "status",
        "citation_refs"
      ],
      "properties": {
        "rule_version_id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "check_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "expression": {"type": "object"},
        "comparator": {"enum": ["GT", "GTE", "LT", "LTE", "EQ", "NE", "BETWEEN"]},
        "threshold": {},
        "result_unit": {"type": ["string", "null"]},
        "severity": {"type": "string", "minLength": 1},
        "recommendation_template": {"type": ["string", "null"]},
        "explanation_text": {"type": ["string", "null"]},
        "priority": {"type": "integer"},
        "is_default": {"type": "boolean"},
        "status": {"const": "released"},
        "citation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
