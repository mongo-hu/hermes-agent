{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/ontology-snapshot.schema.json",
  "title": "Published DFM Ontology Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "ontology_version",
    "published_at",
    "content_sha256",
    "rule_set",
    "concepts",
    "relations",
    "factor_options",
    "rules"
  ],
  "properties": {
    "schema_version": {"enum": [2, 3]},
    "snapshot_id": {"type": "string", "minLength": 1},
    "ontology_version": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule_set": {"$ref": "#/$defs/ruleSet"},
    "concepts": {"type": "array"},
    "relations": {"type": "array"},
    "factor_options": {"type": "array"},
    "rules": {"type": "array"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 3}}},
      "then": {"properties": {
        "concepts": {"items": {"$ref": "#/$defs/concept3"}},
        "relations": {"items": {"$ref": "#/$defs/relation3"}},
        "factor_options": {"items": {"$ref": "#/$defs/factorOption3"}},
        "rules": {"items": {"$ref": "#/$defs/ruleVersion3"}}
      }},
      "else": {"properties": {
        "concepts": {"items": {"$ref": "#/$defs/concept"}},
        "relations": {"items": {"$ref": "#/$defs/relation"}},
        "factor_options": {"items": {"$ref": "#/$defs/factorOption"}},
        "rules": {"items": {"$ref": "#/$defs/ruleVersion"}}
      }}
    }
  ],
  "$defs": {
    "ruleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_set_code", "version", "process", "scope_type", "scope_key"],
      "properties": {
        "rule_set_code": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "process": {"type": "string", "minLength": 1},
        "scope_type": {"enum": ["system", "organization", "customer"]},
        "scope_key": {"type": "string", "minLength": 1}
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "concept_type", "name_zh", "definition", "status"],
      "properties": {
        "concept_id": {"type": "string", "minLength": 1},
        "concept_type": {"enum": ["process", "feature_type", "geometric", "check", "factor"]},
        "name_zh": {"type": "string", "minLength": 1},
        "name_en": {"type": "string"},
        "definition": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "data_schema": {"type": ["object", "null"]},
        "properties": {"type": "object"},
        "status": {"enum": ["draft", "active", "retired"]}
      },
      "allOf": [
        {
          "if": {
            "required": ["concept_type"],
            "properties": {"concept_type": {"const": "factor"}}
          },
          "then": {
            "required": ["properties"],
            "properties": {
              "properties": {
                "required": ["source_policy"],
                "properties": {
                  "source_policy": {"$ref": "#/$defs/sourcePolicy"}
                }
              }
            }
          }
        }
      ]
    },
    "concept3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "concept_type", "name_zh", "definition", "properties_json", "status"],
      "properties": {
        "concept_id": {"type": "string", "minLength": 1},
        "concept_type": {"enum": ["process", "feature_type", "geometric", "check", "factor"]},
        "name_zh": {"type": "string", "minLength": 1},
        "name_en": {"type": "string"},
        "definition": {"type": "string", "minLength": 1},
        "aliases_json": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "data_schema_json": {"type": ["object", "null"]},
        "properties_json": {"type": "object"},
        "status": {"enum": ["draft", "active", "retired"]}
      },
      "allOf": [{
        "if": {"required": ["concept_type"], "properties": {"concept_type": {"const": "factor"}}},
        "then": {"properties": {"properties_json": {
          "required": ["source_policy"],
          "properties": {"source_policy": {"$ref": "#/$defs/sourcePolicy"}}
        }}}
      }]
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_sources",
        "auto_accept_sources",
        "confirmation_required_sources",
        "min_confidence",
        "evidence_required",
        "conflict_policy",
        "missing_policy"
      ],
      "properties": {
        "allowed_sources": {"$ref": "#/$defs/factorSources"},
        "auto_accept_sources": {"$ref": "#/$defs/factorSources"},
        "confirmation_required_sources": {"$ref": "#/$defs/factorSources"},
        "min_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_required": {"type": "boolean"},
        "conflict_policy": {"const": "ask_user"},
        "missing_policy": {"const": "ask_user"}
      }
    },
    "factorSources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "USR",
          "DWG",
          "CAD",
          "GEO",
          "DOC",
          "DB",
          "DER",
          "DEF"
        ]
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "subject_id", "predicate", "object_id", "qualifiers"],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "predicate": {"enum": ["HAS_CHECK", "APPLIES_TO_FEATURE", "USES_OPERAND", "REQUIRES_FACTOR", "AFFECTS", "RELATED_TO"]},
        "object_id": {"type": "string", "minLength": 1},
        "qualifiers": {"type": "object"},
        "sort_order": {"type": "integer"}
      },
      "allOf": [
        {
          "if": {"properties": {"predicate": {"const": "USES_OPERAND"}}},
          "then": {"properties": {"qualifiers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "aggregation", "required", "operand_text"],
            "properties": {
              "alias": {"type": "string", "minLength": 1},
              "aggregation": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "operand_text": {"type": "string", "minLength": 1}
            }
          }}}
        }
      ]
    },
    "relation3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "subject_id", "predicate", "object_id", "qualifiers_json"],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "predicate": {"enum": ["HAS_CHECK", "APPLIES_TO_FEATURE", "USES_OPERAND", "REQUIRES_FACTOR", "AFFECTS", "RELATED_TO"]},
        "object_id": {"type": "string", "minLength": 1},
        "qualifiers_json": {"type": "object"},
        "sort_order": {"type": "integer"}
      },
      "allOf": [{
        "if": {"properties": {"predicate": {"const": "USES_OPERAND"}}},
        "then": {"properties": {"qualifiers_json": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alias", "aggregation", "required", "operand_text"],
          "properties": {
            "alias": {"type": "string", "minLength": 1},
            "aggregation": {"type": "string", "minLength": 1},
            "required": {"type": "boolean"},
            "operand_text": {"type": "string", "minLength": 1}
          }
        }}}
      }]
    },
    "factorOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "option_code", "name_zh", "value", "status"],
      "properties": {
        "factor_id": {"type": "string", "minLength": 1},
        "option_code": {"type": "string", "minLength": 1},
        "name_zh": {"type": "string", "minLength": 1},
        "value": {},
        "sort_order": {"type": "integer"},
        "status": {"enum": ["active", "retired"]}
      }
    },
    "factorOption3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "option_code", "name_zh", "value_json", "status"],
      "properties": {
        "factor_id": {"type": "string", "minLength": 1},
        "option_code": {"type": "string", "minLength": 1},
        "name_zh": {"type": "string", "minLength": 1},
        "value_json": {},
        "sort_order": {"type": "integer"},
        "status": {"enum": ["active", "retired"]}
      }
    },
    "condition": {
      "oneOf": [
        {"$ref": "#/$defs/factorCondition"},
        {"$ref": "#/$defs/geometricCondition"}
      ]
    },
    "factorCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "operator"],
      "properties": {
        "factor_id": {"type": "string", "minLength": 1},
        "operator": {"enum": ["EQ", "IN", "GT", "GTE", "LT", "LTE", "BETWEEN", "EXISTS"]},
        "value": {}
      }
    },
    "geometricCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometric_id", "operator", "value", "unit"],
      "properties": {
        "geometric_id": {"type": "string", "minLength": 1},
        "operator": {"enum": ["GT", "GTE", "LT", "LTE"]},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "expression", "comparator", "threshold", "result_unit"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "expression": {"type": "object"},
        "comparator": {"enum": ["GT", "GTE", "LT", "LTE", "EQ", "NE", "BETWEEN"]},
        "threshold": {},
        "result_unit": {"type": "string"}
      }
    },
    "ruleVersion3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_version_id", "rule_id", "version", "check_id", "name", "conditions_json", "acceptance_criteria_json", "severity", "severity_rationale", "priority", "is_default", "status", "citation_refs"],
      "properties": {
        "rule_version_id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "check_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "conditions_json": {"type": "array", "items": {"$ref": "#/$defs/factorCondition"}},
        "acceptance_criteria_json": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/acceptanceCriterion"}},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "severity_rationale": {"type": "string", "minLength": 1},
        "recommendation_template": {"type": ["string", "null"]},
        "explanation_text": {"type": ["string", "null"]},
        "priority": {"type": "integer"},
        "is_default": {"type": "boolean"},
        "status": {"const": "released"},
        "citation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "ruleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_version_id", "rule_id", "version", "check_id", "name", "conditions", "expression", "comparator", "threshold", "severity", "priority", "is_default", "status", "citation_refs"],
      "properties": {
        "rule_version_id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "check_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "expression": {"type": "object"},
        "comparator": {"enum": ["GT", "GTE", "LT", "LTE", "EQ", "NE", "BETWEEN"]},
        "threshold": {},
        "result_unit": {"type": ["string", "null"]},
        "severity": {"type": "string", "minLength": 1},
        "recommendation_template": {"type": ["string", "null"]},
        "explanation_text": {"type": ["string", "null"]},
        "priority": {"type": "integer"},
        "is_default": {"type": "boolean"},
        "status": {"const": "released"},
        "citation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
