{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/geometry-discovery-task.schema.json",
  "title": "Hermes DFM Geometry Discovery Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "input_id",
    "input_sha256",
    "input_format",
    "process",
    "recognizer_ids",
    "facts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "input_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_format": {"type": "string", "minLength": 1},
    "process": {"type": "string", "minLength": 1},
    "recognizer_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "facts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/resolvedArgument"}
    }
  },
  "$defs": {
    "resolvedArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source_ref", "unit"],
      "properties": {
        "value": {},
        "source_ref": {"type": "string", "minLength": 1},
        "unit": {"type": ["string", "null"]}
      }
    }
  }
}
