{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/feature.schema.json",
  "title": "Hermes DFM 3D Feature",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "kind", "source_refs", "confidence", "subtype", "geometry_refs", "parameters", "method", "algorithm_version", "input_sha256", "quality", "diagnostics", "region_refs", "properties", "relationships", "recognizer", "recognizer_version", "status"],
  "properties": {
    "feature_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "subtype": {"type": "string"},
    "geometry_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/geometryRef"}},
    "parameters": {"type": "object"},
    "method": {"type": "string"},
    "algorithm_version": {"type": "string"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "quality": {"type": "object"},
    "diagnostics": {"type": "object"},
    "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "properties": {"type": "object"},
    "relationships": {"type": "array", "items": {"type": "object"}},
    "recognizer": {"type": "string", "minLength": 1},
    "recognizer_version": {"type": "string"},
    "status": {"enum": ["detected", "confirmed", "rejected", "needs_confirmation"]}
  },
  "$defs": {
    "geometryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index", "input_sha256", "topology_snapshot_id", "entity_id"],
      "properties": {
        "kind": {"enum": ["face", "edge", "solid", "vertex"]},
        "index": {"type": "integer", "minimum": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "topology_snapshot_id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
