{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/feature.schema.json",
  "title": "Hermes DFM 3D Feature",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "kind", "source_refs", "confidence", "input_sha256", "region_refs", "properties", "relationships", "recognizer", "recognizer_version", "status"],
  "properties": {
    "feature_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "region_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "properties": {"type": "object"},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation", "target_ref"],
        "properties": {
          "relation": {"type": "string", "minLength": 1},
          "target_ref": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "recognizer": {"type": "string", "minLength": 1},
    "recognizer_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["detected", "confirmed", "rejected", "needs_confirmation"]}
  }
}
