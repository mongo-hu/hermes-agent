{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/observation.schema.json",
  "title": "Hermes DFM Input Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "input_id", "kind", "value", "source_refs", "confidence", "status", "unit", "region_refs", "feature_refs", "provenance"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "input_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "value": {},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["candidate", "confirmed", "rejected", "conflict", "needs_confirmation"]},
    "unit": {"type": ["string", "null"]},
    "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object"}
  }
}
