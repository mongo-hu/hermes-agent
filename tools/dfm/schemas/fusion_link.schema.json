{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/fusion-link.schema.json",
  "title": "Hermes DFM Observation-to-Geometry Fusion Link",
  "type": "object",
  "additionalProperties": false,
  "required": ["fusion_link_id", "observation_refs", "feature_refs", "region_refs", "confidence", "status", "method", "diagnostics"],
  "properties": {
    "fusion_link_id": {"type": "string", "minLength": 1},
    "observation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["candidate", "confirmed", "rejected", "ambiguous"]},
    "method": {"type": "string", "minLength": 1},
    "diagnostics": {"type": "object"}
  }
}
