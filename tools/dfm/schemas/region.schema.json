{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/region.schema.json",
  "title": "Hermes DFM Region",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "region_id",
    "input_sha256",
    "coordinate_system",
    "mode",
    "semantic_label",
    "source_refs",
    "version",
    "content_sha256",
    "bbox",
    "geometry_refs",
    "excluded_geometry_refs",
    "role",
    "feature_refs"
  ],
  "properties": {
    "region_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinate_system": {"type": "string", "minLength": 1},
    "mode": {
      "enum": ["bbox", "topology_refs", "topology_complement", "whole_model"]
    },
    "semantic_label": {"type": "string"},
    "source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "version": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bbox": {
      "type": ["object", "null"],
      "required": ["minimum", "maximum"],
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false
        },
        "maximum": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false
        }
      }
    },
    "geometry_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/geometryRef"}
    },
    "excluded_geometry_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/geometryRef"}
    },
    "role": {"type": "string"},
    "feature_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "bbox"}}},
      "then": {"properties": {"bbox": {"type": "object"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "topology_refs"}}},
      "then": {"properties": {"geometry_refs": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"mode": {"const": "topology_complement"}}},
      "then": {"properties": {"excluded_geometry_refs": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"mode": {"const": "whole_model"}}},
      "then": {
        "properties": {
          "bbox": {"type": "null"},
          "geometry_refs": {"maxItems": 0},
          "excluded_geometry_refs": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "geometryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index",
        "input_sha256",
        "topology_snapshot_id",
        "entity_id"
      ],
      "properties": {
        "kind": {"const": "face"},
        "index": {"type": "integer", "minimum": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "topology_snapshot_id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
