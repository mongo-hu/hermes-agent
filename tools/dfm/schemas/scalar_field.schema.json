{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/scalar-field.schema.json",
  "title": "Hermes DFM Objective Scalar Field",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "field_id", "run_id", "input_sha256", "operation_id", "metric_id", "quantity_id", "unit", "scene_ref", "topology_map_ref", "topology_snapshot_ref", "render_mesh_snapshot_ref", "interpolation", "calculation_context", "feature_refs", "region_refs", "samples", "cells", "quality"],
  "properties": {
    "schema_version": {"const": 2},
    "field_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_id": {"type": "string", "minLength": 1},
    "metric_id": {"type": "string", "minLength": 1},
    "quantity_id": {"type": "string", "minLength": 1},
    "unit": {"type": ["string", "null"]},
    "scene_ref": {"type": "string", "minLength": 1},
    "topology_map_ref": {"type": "string", "minLength": 1},
    "topology_snapshot_ref": {"type": "string", "minLength": 1},
    "render_mesh_snapshot_ref": {"type": "string", "minLength": 1},
    "interpolation": {"enum": ["linear_on_triangle", "constant_per_triangle"]},
    "calculation_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pull_direction": {"$ref": "#/$defs/vector3"}
      }
    },
    "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "point", "uv", "surface_normal", "value", "geometry_ref", "mesh_vertex_ref"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "point": {"$ref": "#/$defs/vector3"},
          "uv": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "surface_normal": {"$ref": "#/$defs/vector3"},
          "value": {"type": "number"},
          "geometry_ref": {"$ref": "#/$defs/geometryRef"},
          "mesh_vertex_ref": {
            "oneOf": [
              {"$ref": "#/$defs/vertexRef"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell_id", "sample_ids", "geometry_ref", "triangle_ref"],
        "properties": {
          "cell_id": {"type": "string", "minLength": 1},
          "sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "geometry_ref": {"$ref": "#/$defs/geometryRef"},
          "triangle_ref": {"$ref": "#/$defs/triangleRef"}
        }
      }
    },
    "quality": {"type": "object"}
  },
  "$defs": {
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "geometryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index", "input_sha256", "topology_snapshot_id", "entity_id"],
      "properties": {
        "kind": {"const": "face"},
        "index": {"type": "integer", "minimum": 0},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "topology_snapshot_id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1}
      }
    },
    "vertexRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_id", "vertex_id", "render_mesh_snapshot_id"],
      "properties": {
        "primitive_id": {"type": "string", "minLength": 1},
        "vertex_id": {"type": "integer", "minimum": 0},
        "render_mesh_snapshot_id": {"type": "string", "minLength": 1}
      }
    },
    "triangleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_id", "triangle_id", "render_mesh_snapshot_id"],
      "properties": {
        "primitive_id": {"type": "string", "minLength": 1},
        "triangle_id": {"type": "integer", "minimum": 0},
        "render_mesh_snapshot_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
