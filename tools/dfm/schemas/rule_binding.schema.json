{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/rule-binding.schema.json",
  "title": "Hermes DFM Rule Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_id", "operation_id", "metric_id", "quantity_id", "rule_id", "operator", "aggregation"],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "metric_id": {"type": "string", "minLength": 1},
    "quantity_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "operator": {"enum": [">=", "<=", ">", "<", "==", "!=", "between"]},
    "aggregation": {"enum": ["minimum", "maximum", "mean", "median", "sum", "count", "identity"]},
    "required_fact_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "check_id": {"type": "string"},
    "operand_alias": {"type": "string", "minLength": 1},
    "additional_operands": {
      "type": "array",
      "items": {"$ref": "#/$defs/operand"}
    },
    "expression": {
      "oneOf": [
        {"$ref": "#/$defs/expression"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "additional_operands": {"minItems": 1}
        },
        "required": ["additional_operands"]
      },
      "then": {
        "required": ["check_id", "expression"],
        "properties": {
          "check_id": {"minLength": 1},
          "expression": {"$ref": "#/$defs/expression"}
        }
      }
    }
  ],
  "$defs": {
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "operation_id", "metric_id", "quantity_id", "aggregation", "feature_refs", "region_refs"],
      "properties": {
        "alias": {"type": "string", "minLength": 1},
        "operation_id": {"type": "string", "minLength": 1},
        "metric_id": {"type": "string", "minLength": 1},
        "quantity_id": {"type": "string", "minLength": 1},
        "aggregation": {"enum": ["minimum", "maximum", "mean", "median", "sum", "count", "identity"]},
        "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operand"],
          "properties": {"operand": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["constant"],
          "properties": {
            "constant": {"type": "number"},
            "unit": {"type": ["string", "null"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": {"enum": ["add", "subtract", "multiply", "divide", "minimum", "maximum", "abs", "negate"]},
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/expression"}
            }
          }
        }
      ]
    }
  }
}
