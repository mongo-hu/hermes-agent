{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/nx-capability.schema.json",
  "title": "Hermes DFM NX Capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "backend_version", "plugin_version", "formats", "calculators"],
  "properties": {
    "status": {"enum": ["available", "unhealthy"]},
    "backend_version": {"type": "string"},
    "plugin_version": {"type": "string"},
    "formats": {"type": "object", "additionalProperties": {"type": "string"}},
    "details": {"type": "object"},
    "calculators": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "contract_version", "implementation_version", "required_arguments", "optional_arguments", "supported_algorithm_options", "output_quantities", "output_artifact_kinds", "supported_formats", "supported_region_modes", "supported_nx_versions", "certification_report_sha256"],
        "properties": {
          "status": {"enum": ["certified", "not_implemented", "unhealthy"]},
          "contract_version": {"const": 4},
          "implementation_version": {"type": "string"},
          "required_arguments": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "optional_arguments": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "supported_algorithm_options": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "output_quantities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "output_artifact_kinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["scalar_field", "render_scene", "topology_map"]}},
          "supported_formats": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "supported_region_modes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "supported_nx_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "certification_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
