{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/render-scene.schema.json",
  "title": "Hermes DFM Neutral Render Scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "run_id", "input_sha256", "coordinate_system", "unit", "topology_snapshot_ref", "render_mesh_snapshot", "primitives"],
  "properties": {
    "schema_version": {"const": 2},
    "scene_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinate_system": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "topology_snapshot_ref": {"type": "string", "minLength": 1},
    "render_mesh_snapshot": {"$ref": "#/$defs/renderMeshSnapshot"},
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primitive_id", "render_mesh_snapshot_id", "vertices", "triangles"],
        "properties": {
          "primitive_id": {"type": "string", "minLength": 1},
          "render_mesh_snapshot_id": {"type": "string", "minLength": 1},
          "vertices": {"type": "array", "items": {"$ref": "#/$defs/point3"}},
          "triangles": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "point3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "renderMeshSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["render_mesh_snapshot_id", "topology_snapshot_id", "input_sha256", "producer", "producer_version", "tessellation", "triangle_count", "render_mesh_sha256"],
      "properties": {
        "render_mesh_snapshot_id": {"type": "string", "minLength": 1},
        "topology_snapshot_id": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "producer": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "tessellation": {"type": "object"},
        "triangle_count": {"type": "integer", "minimum": 1},
        "render_mesh_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
