{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/discovery-snapshot.schema.json",
  "title": "Hermes DFM Immutable Discovery Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "created_at", "input_hashes", "observation_refs", "feature_refs", "fusion_link_refs", "provider_versions", "content_sha256", "status", "process", "confirmed_fact_refs"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "input_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "observation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "feature_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "region_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fusion_link_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provider_versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "frozen"},
    "process": {"type": "string"},
    "confirmed_fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "geometry_snapshot_ref": {"type": "string"},
    "topology_snapshot_id": {"type": "string"},
    "render_mesh_snapshot_id": {"type": "string"},
    "worker_snapshot_id": {"type": "string"},
    "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "annotations": {
      "type": "array", "items": {"type": "object", "required": ["annotation_id", "kind"],
        "properties": {"annotation_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}}}
    },
    "relationships": {
      "type": "array", "items": {"type": "object", "required": ["relation_id", "type", "from_ref", "to_ref"],
        "properties": {"relation_id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
          "from_ref": {"type": "string", "minLength": 1}, "to_ref": {"type": "string", "minLength": 1}}}
    },
    "forming_scopes": {
      "type": "array", "items": {"type": "object", "required": ["forming_scope_id", "kind", "mode"],
        "properties": {"forming_scope_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["main_forming", "undercut", "local_forming"]}, "mode": {"enum": ["main", "local"]}}}
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_kind", "context", "status", "covered_geometry_ref", "unresolved_geometry_ref", "diagnostics"],
        "properties": {
          "feature_kind": {"type": "string", "minLength": 1},
          "context": {"type": "object"},
          "status": {"enum": ["complete", "partial", "failed"]},
          "covered_geometry_ref": {"type": "object"},
          "unresolved_geometry_ref": {"type": ["object", "null"]},
          "diagnostics": {"type": "object"}
        }
      }
    }
  }
}
