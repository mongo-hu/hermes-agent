{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/objective-result-manifest.schema.json",
  "title": "Hermes Objective Result Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_version", "run_id", "input_sha256", "process", "scope_id", "scope_version", "result_path", "artifacts"],
  "properties": {
    "schema_version": {"const": 4},
    "producer_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "process": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "scope_version": {"type": "string", "minLength": 1},
    "result_path": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "filename", "media_type", "size_bytes", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
