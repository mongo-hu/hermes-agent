{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/geometry/request-v2.schema.json",
  "title": "DFM geometry persistent-session JSON-RPC request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "allOf": [{
    "if": {"required": ["as_job"]},
    "then": {"properties": {"method": {"enum": ["snapshots.open", "features.revise", "annotations.revise", "forming_scopes.revise", "snapshots.merge"]}}}
  }],
  "properties": {
    "as_job": {"const": true},
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "method": {
      "enum": [
        "capabilities.get",
        "snapshots.open",
        "snapshots.get",
        "snapshots.renew",
        "snapshots.close",
        "features.discover",
        "features.revise",
        "annotations.revise",
        "forming_scopes.analyze",
        "forming_scopes.revise",
        "snapshots.merge",
        "geometrics.compute",
        "jobs.status",
        "jobs.cancel",
        "fields.prepare"
      ]
    },
    "params": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "method": {
          "const": "capabilities.get"
        },
        "params": {
          "$ref": "#/$defs/emptyParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "snapshots.open"
        },
        "params": {
          "$ref": "#/$defs/openSnapshotParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "snapshots.get"
        },
        "params": {
          "$ref": "#/$defs/snapshotParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "snapshots.renew"
        },
        "params": {
          "$ref": "#/$defs/renewSnapshotParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "snapshots.close"
        },
        "params": {
          "$ref": "#/$defs/snapshotParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "features.discover"
        },
        "params": {
          "$ref": "#/$defs/discoverFeaturesParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "features.revise"
        },
        "params": {
          "$ref": "#/$defs/reviseFeaturesParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "annotations.revise"
        },
        "params": {
          "$ref": "https://hermes.local/dfm/geometry/session-v2.schema.json#/$defs/annotations_revise_request"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "forming_scopes.analyze"
        },
        "params": {
          "$ref": "#/$defs/analyzeFormingScopeParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "forming_scopes.revise"
        },
        "params": {
          "$ref": "#/$defs/reviseFormingScopesParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "snapshots.merge"
        },
        "params": {
          "$ref": "#/$defs/mergeSnapshotsParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "geometrics.compute"
        },
        "params": {
          "$ref": "#/$defs/computeGeometricsParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "enum": [
            "jobs.status",
            "jobs.cancel"
          ]
        },
        "params": {
          "$ref": "#/$defs/jobParams"
        }
      }
    },
    {
      "properties": {
        "method": {
          "const": "fields.prepare"
        },
        "params": {
          "$ref": "#/$defs/prepareFieldsParams"
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snapshot_[A-Za-z0-9_-]+$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^job_[A-Za-z0-9_-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "leaseSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "direction": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "geometryRefs": {
      "type": "array",
      "items": {
        "$ref": "https://hermes.local/dfm/geometry/common.schema.json#/$defs/geometryRef"
      }
    },
    "emptyParams": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "snapshotParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/snapshotId"
        }
      }
    },
    "openSnapshotParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_path",
        "input_sha256",
        "artifact_dir"
      ],
      "properties": {
        "input_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_dir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "lease_seconds": {
          "$ref": "#/$defs/leaseSeconds"
        }
      }
    },
    "renewSnapshotParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/snapshotId"
        },
        "lease_seconds": {
          "$ref": "#/$defs/leaseSeconds"
        }
      }
    },
    "featureKind": {
      "enum": [
        "main_wall",
        "rib",
        "solid_boss",
        "hollow_boss",
        "blend",
        "chamfer",
        "isolated"
      ]
    },
    "discoverFeaturesParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "feature_kinds"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/snapshotId"
        },
        "feature_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/featureKind"
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forming_scope_id": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "reviseFeaturesParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "revisions"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/snapshotId"
        },
        "revisions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature_id"
            ],
            "allOf": [
              {
                "if": {
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "create"
                    }
                  }
                },
                "then": {
                  "required": [
                    "kind",
                    "geometry_refs"
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "enum": [
                        "delete",
                        "unlock"
                      ]
                    }
                  }
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "kind"
                        ]
                      },
                      {
                        "required": [
                          "geometry_refs"
                        ]
                      },
                      {
                        "required": [
                          "parts"
                        ]
                      },
                      {
                        "required": [
                          "parameters"
                        ]
                      }
                    ]
                  }
                }
              }
            ],
            "properties": {
              "feature_id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "action": {
                "enum": [
                  "create",
                  "update",
                  "delete",
                  "unlock"
                ]
              },
              "kind": {
                "$ref": "#/$defs/featureKind"
              },
              "geometry_refs": {
                "$ref": "#/$defs/geometryRefs"
              },
              "parts": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/geometryRefs"
                }
              },
              "parameters": {
                "type": "object"
              },
              "source": {
                "const": "user_confirmed"
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ownership_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "face_index"
            ],
            "properties": {
              "face_index": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "enum": [
                  "set",
                  "clear"
                ]
              },
              "decision": {
                "enum": [
                  "shared",
                  "exclusive",
                  "unresolved"
                ]
              },
              "candidates": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "owner_feature_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "const": "clear"
                    }
                  }
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "decision"
                        ]
                      },
                      {
                        "required": [
                          "candidates"
                        ]
                      },
                      {
                        "required": [
                          "owner_feature_id"
                        ]
                      }
                    ]
                  }
                },
                "else": {
                  "required": [
                    "decision",
                    "candidates"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "decision": {
                            "const": "exclusive"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "owner_feature_id"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "owner_feature_id"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "revisions"
          ],
          "properties": {
            "revisions": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "relationships"
          ],
          "properties": {
            "relationships": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "ownership_decisions"
          ],
          "properties": {
            "ownership_decisions": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "analyzeFormingScopeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "forming_scope_id",
        "mode",
        "draw_direction",
        "coordinate_system",
        "direction_source"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/snapshotId"
        },
        "forming_scope_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mode": {
          "enum": [
            "main",
            "local"
          ]
        },
        "appearance_preview_only": { "type": "boolean" },
        "draw_direction": {
          "$ref": "#/$defs/direction"
        },
        "coordinate_system": {
          "const": "model"
        },
        "direction_source": {
          "const": "user_confirmed"
        }
      }
    },
    "formingScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forming_scope_id"
      ],
      "properties": {
        "forming_scope_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "main_forming",
            "undercut",
            "local_forming"
          ]
        },
        "mode": {
          "enum": [
            "main",
            "local"
          ]
        },
        "draw_direction": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/direction"
            }
          ]
        },
        "coordinate_system": {
          "const": "model"
        },
        "direction_source": {
          "enum": [
            null,
            "inferred",
            "user_confirmed"
          ]
        },
        "supersedes_scope_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "geometry_refs": {
          "$ref": "#/$defs/geometryRefs"
        },
        "status": {
          "enum": [
            "candidate",
            "confirmed"
          ]
        },
        "patch_mask_ref": {
          "type": "null"
        },
        "mechanism_kind": {
          "enum": [
            "none",
            "slider",
            "lifter",
            "undetermined"
          ]
        },
        "undercut_geometry_refs": {
          "$ref": "#/$defs/geometryRefs"
        },
        "candidate_solutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mechanism_kind",
              "geometry_refs",
              "draw_direction"
            ],
            "properties": {
              "mechanism_kind": {
                "enum": [
                  "slider",
                  "lifter",
                  "undetermined"
                ]
              },
              "geometry_refs": {
                "$ref": "#/$defs/geometryRefs"
              },
              "draw_direction": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              },
              "coordinate_system": {
                "const": "model"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "reviseFormingScopesParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "scopes"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/snapshotId"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formingScope"
          }
        },
        "retire_scope_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "mergeSnapshotsParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_snapshot_id",
        "snapshot_ids"
      ],
      "properties": {
        "base_snapshot_id": {
          "$ref": "#/$defs/snapshotId"
        },
        "snapshot_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/snapshotId"
          }
        }
      }
    },
    "geometricContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fillet_location": {"type": "string", "enum": ["outer_root", "hole_bottom"]},
        "sample_spacing_mm": {"type": "number", "exclusiveMinimum": 0},
        "mesh_deflection_mm": {"type": "number", "exclusiveMinimum": 0},
        "convergence_tolerance_mm": {"type": "number", "exclusiveMinimum": 0},
        "nominal_relative_tolerance": {"type": "number", "minimum": 0.05, "maximum": 0.10},
        "appearance_delta_threshold_mm": {"type": "number", "minimum": 0, "maximum": 1000000},
        "non_appearance_delta_threshold_mm": {"type": "number", "minimum": 0, "maximum": 1000000},
        "boundary_width_ratio": {"type": "number", "minimum": 0.5, "maximum": 1.0},
        "nominal_thickness_mm": {"type": "number", "minimum": 0, "maximum": 1000000},
        "length_relative_tolerance": {"type": "number", "minimum": 0.0001, "maximum": 0.05},
        "length_absolute_tolerance_mm": {"type": "number", "minimum": 0.00001, "maximum": 1.0},
        "forming_scope_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "draw_direction": {
          "$ref": "#/$defs/direction"
        },
        "coordinate_system": {
          "const": "model"
        },
        "direction_source": {
          "const": "user_confirmed"
        },
        "feature_role": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "computeGeometricsParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "items"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/snapshotId"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature_id",
              "geometric_ids",
              "context"
            ],
            "properties": {
              "feature_id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "geometric_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^G_[A-Z0-9_]+$"
                }
              },
              "context": {
                "$ref": "#/$defs/geometricContext"
              }
            }
          }
        }
      }
    },
    "jobParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/jobId"
        }
      }
    },
    "prepareFieldsParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "fields"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/snapshotId"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "wall_thickness",
              "normal_thickness",
              "draft"
            ]
          }
        }
      }
    }
  }
}
