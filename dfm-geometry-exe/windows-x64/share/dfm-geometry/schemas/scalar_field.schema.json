{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/geometry/scalar-field-v2.schema.json",
  "title": "DFM geometry persistent-session scalar field",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "field_id", "snapshot_id", "input_sha256", "feature_id", "feature_refs", "geometric_ids", "context", "unit", "scene_ref", "topology_map_ref", "topology_snapshot_ref", "render_mesh_snapshot_ref", "interpolation", "calculation_context", "samples", "cells", "quality"],
  "properties": {
    "schema_version": {"const": 2},
    "contract_version": {"const": "dfm.geometry/v2"},
    "field_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_id": {"type": "string", "minLength": 1},
    "feature_refs": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "geometric_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^G_[A-Z0-9_]+$"}},
    "context": {"type": "object"},
    "unit": {"type": ["string", "null"]},
    "scene_ref": {"type": "string", "minLength": 1},
    "topology_map_ref": {"type": "string", "minLength": 1},
    "topology_snapshot_ref": {"type": "string", "minLength": 1},
    "render_mesh_snapshot_ref": {"type": "string", "minLength": 1},
    "interpolation": {"enum": ["linear_on_triangle", "constant_per_triangle"]},
    "calculation_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pull_direction": {"$ref": "https://hermes.local/dfm/geometry/common.schema.json#/$defs/vector3"}
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "point", "uv", "surface_normal", "value", "geometry_ref", "mesh_vertex_ref"],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "point": {"$ref": "https://hermes.local/dfm/geometry/common.schema.json#/$defs/vector3"},
          "uv": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "surface_normal": {"$ref": "https://hermes.local/dfm/geometry/common.schema.json#/$defs/vector3"},
          "value": {"type": "number"},
          "geometry_ref": {"$ref": "https://hermes.local/dfm/geometry/common.schema.json#/$defs/faceGeometryRef"},
          "mesh_vertex_ref": {
            "oneOf": [
              {"$ref": "https://hermes.local/dfm/geometry/common.schema.json#/$defs/meshVertexRef"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell_id", "sample_ids", "geometry_ref", "triangle_ref"],
        "properties": {
          "cell_id": {"type": "string", "minLength": 1},
          "sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "geometry_ref": {"$ref": "https://hermes.local/dfm/geometry/common.schema.json#/$defs/faceGeometryRef"},
          "triangle_ref": {"$ref": "https://hermes.local/dfm/geometry/common.schema.json#/$defs/triangleRef"}
        }
      }
    },
    "render_samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primitive_id", "encoding", "layout", "stride", "sample_count", "origin", "data"],
        "properties": {
          "primitive_id": {"type": "string", "minLength": 1},
          "encoding": {"const": "float32-le-base64"},
          "layout": {"const": ["dx_mm", "dy_mm", "dz_mm", "value"]},
          "stride": {"const": 4},
          "sample_count": {"type": "integer", "minimum": 1},
          "origin": {"$ref": "https://hermes.local/dfm/geometry/common.schema.json#/$defs/vector3"},
          "data": {"type": "string", "minLength": 1, "contentEncoding": "base64"}
        }
      }
    },
    "quality": {"type": "object"}
  }
}

