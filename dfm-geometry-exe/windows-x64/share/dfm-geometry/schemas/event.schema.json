{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/geometry/job-status-v2.schema.json",
  "title": "DFM geometry asynchronous job status",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "job_id", "method", "status", "progress", "result", "error"],
  "properties": {
    "contract_version": {"const": "dfm.geometry/v2"},
    "job_id": {"type": "string", "minLength": 1},
    "method": {"enum": ["features.discover", "forming_scopes.analyze", "geometrics.compute"]},
    "status": {"enum": ["queued", "running", "completed", "failed", "cancelled"]},
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "percent", "details"],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "details": {"type": "object"}
      }
    },
    "result": {"type": ["object", "null"]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "detail"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "detail": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
